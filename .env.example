# Copia generada automaticamente por bootstrap.ps1 como .env
GITEA_VERSION=1
DIND_VERSION=27
RUNNER_VERSION=latest

GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
REGISTRY_PORT=5000
REGISTRY_UI_PORT=5080

# Usuario administrador de Gitea (solo para este lab local)
GITEA_ADMIN_USER=devops
GITEA_ADMIN_PASSWORD=cambia-esto
GITEA_ADMIN_EMAIL=devops@homelab.local

# Repo que se crea en Gitea y proyecto de origen que se importa
REPO_NAME=productos-api
SOURCE_REPO=C:\Users\deria\OneDrive\Documents\vscode\simulaciones

# SonarQube (http://localhost:9000, usuario admin). Los passwords los genera bootstrap.ps1
SONAR_PORT=9000
SONAR_DB_PASSWORD=
SONAR_ADMIN_PASSWORD=

# Los genera bootstrap.ps1
RUNNER_TOKEN=
SONAR_TOKEN=
